# Required for AI-driven extraction and investigation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Required for PayPal Sandbox transaction verification
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_SECONDS=12

# API configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_USER_TEXT_CHARS=12000
MAX_TOOL_CALLS=12
MAX_MODEL_TURNS=10
MAX_INVESTIGATION_SECONDS=180

# Optional VirusTotal domain reputation (only where your plan permits)
VIRUSTOTAL_API_KEY=
THREAT_INTEL_TIMEOUT_SECONDS=8

# Optional Elastic historical intelligence
ELASTICSEARCH_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=scamairbag-investigations
ELASTIC_TIMEOUT_SECONDS=5
# Set true only if the user explicitly opts in via the frontend checkbox.
ELASTIC_STORE_CASES=false

# Optional Render Workflows integration for asynchronous, minimized indexing
RENDER_API_KEY=
# Format: workflow-slug/index_anonymized_case
RENDER_INDEX_TASK_SLUG=

# Optional Airbag Watchtower event monitoring
PAYPAL_WEBHOOK_ID=
# Public HTTPS API origin, e.g. https://your-api.onrender.com
WATCHTOWER_PUBLIC_API_URL=
WATCHTOWER_DEMO_ENABLED=false
# Generate a long random value; used for the dashboard and authenticated event intake.
WATCHTOWER_INGEST_TOKEN=
# Use a mounted persistent-disk path in hosted deployments if history must survive restarts.
WATCHTOWER_DB_PATH=watchtower.sqlite3
# Keep false unless the account explicitly opts in to minimized historical case storage.
WATCHTOWER_SHARE_ANONYMIZED_INTELLIGENCE=false
